; Engine configuration file.
; Godot 4.7 project for Folded Dungeon (prototype, see README).

config_version=5

[application]

config/name="Folded Dungeon"
run/main_scene="res://presentation/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1100
window/size/viewport_height=760
window/stretch/mode="canvas_items"

[rendering]

environment/defaults/default_clear_color=Color(0.070588, 0.070588, 0.101961, 1)
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
