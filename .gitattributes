# Normalize text files to LF; binary assets stay binary.
* text=auto eol=lf

# Godot text assets
*.gd text eol=lf
*.gdshader text eol=lf
*.gdshaderinc text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.res text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.cfg text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.zip binary
